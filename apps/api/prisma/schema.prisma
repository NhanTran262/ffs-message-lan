// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          BigInt      @id @default(autoincrement())
  fullName    String      @map("full_name") @db.VarChar(50)
  email       String      @unique
  password    String
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime    @default(now()) @map("updated_at") @db.Timestamp(0)
  isActivated Boolean     @default(true) @map("is_activated")
  isDeleted   Boolean     @default(false) @map("is_deleted")
  messages    Message[]
  groupUsers  GroupUser[]

  @@index([createdAt, updatedAt, isActivated, isDeleted, email])
  @@map("users")
}

model Group {
  id        BigInt      @id @default(autoincrement())
  name      String
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime    @default(now()) @map("updated_at") @db.Timestamp(0)
  isDeleted Boolean     @default(false) @map("is_deleted")
  messages  Message[]
  users     GroupUser[]

  @@index([createdAt, updatedAt, isDeleted])
  @@map("groups")
}

model GroupUser {
  id       BigInt   @id @default(autoincrement())
  userId   BigInt   @map("user_id")
  groupId  BigInt   @map("group_id")
  user     User     @relation(fields: [userId], references: [id])
  group    Group    @relation(fields: [groupId], references: [id])
  joinedAt DateTime @default(now()) @db.Timestamp(0) @map("joined_at")
  leavedAt DateTime @default(now()) @db.Timestamp(0) @map("leaved_at")

  @@unique([userId, groupId])
  @@index([joinedAt])
  @@map("group_users")
}

model Message {
  id        BigInt   @id @default(autoincrement())
  senderId  BigInt   @map("sender_id")
  groupId   BigInt   @map("group_id")
  content   String   @db.LongText
  sender    User     @relation(fields: [senderId], references: [id])
  group     Group    @relation(fields: [groupId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@index([groupId, createdAt,senderId])
  @@map("messages")
}
