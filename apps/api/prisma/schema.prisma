// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  BigInt             @id @default(autoincrement())
  fullName            String             @map("full_name") @db.VarChar(50)
  phone               String             @unique
  password            String
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime?          @map("updated_at") @db.Timestamp(0)
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamp(0)
  isActivated         Boolean            @default(true) @map("is_activated")
  isDeleted           Boolean            @default(false) @map("is_deleted")
  deleteById          BigInt?            @map("delete_by_id")
  deleteBy            User?              @relation("UserDeletedBy", fields: [deleteById], references: [id])
  userRoles           UserRole[]
  deletedUsers        User[]             @relation("UserDeletedBy")
  images              Image[]
  deleteImages        Image[]            @relation("ImageDeleteBy")
  deleteConversations Conversation[]     @relation("ConversationDeleteBy")
  conversationUsers   ConversationUser[]
  messageSender       Message[]          @relation("MessageSender")
  messageReceiver     Message[]          @relation("MessageReceiver")

  @@index([createdAt, updatedAt, deletedAt, isActivated, isDeleted, phone, deleteById], name: "idx_user_active_status")
  @@map("users")
}

model Role {
  id        BigInt     @id @default(autoincrement())
  name      String     @db.VarChar(20)
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@index([userId, roleId], name: "idx_user_role_active_status")
  @@map("user_roles")
}

model Image {
  id         BigInt    @id @default(autoincrement())
  name       String
  url        String    @db.LongText
  isAvatar   Boolean   @map("is_avatar")
  userId     BigInt    @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime? @map("updated_at") @db.Timestamp(0)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamp(0)
  isDeleted  Boolean   @default(false) @map("is_deleted")
  deleteById BigInt?   @map("delete_by_id")
  user       User      @relation(fields: [userId], references: [id])
  deleteBy   User?     @relation("ImageDeleteBy", fields: [deleteById], references: [id])

  @@index([isAvatar, createdAt, updatedAt, deletedAt, isDeleted, deleteById], name: "idx_image_active_status")
  @@map("images")
}

model Conversation {
  id           BigInt             @id @default(autoincrement())
  name         String?
  isGroup      Boolean            @default(false) @map("is_group")
  isPrivate    Boolean            @default(false) @map("is_private")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime?          @map("updated_at") @db.Timestamp(0)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamp(0)
  isDeleted    Boolean            @default(false) @map("is_deleted")
  deleteById   BigInt?            @map("delete_by_id")
  deleteBy     User?              @relation("ConversationDeleteBy", fields: [deleteById], references: [id])
  messages     Message[]
  participants ConversationUser[]

  @@index([isGroup, isPrivate, createdAt, updatedAt, deletedAt, isDeleted, deleteById], name: "idx_conversation_active_status")
  @@map("conversations")
}

model ConversationUser {
  id             BigInt       @id @default(autoincrement())
  userId         BigInt       @map("user_id")
  conversationId BigInt       @map("conversation_id")
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  isOwner        Boolean      @default(false) @map("is_owner")
  isAdmin        Boolean      @default(false) @map("is_admin")
  isMember       Boolean      @default(false) @map("is_member")
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamp(0)
  leavedAt       DateTime?    @map("leaved_at") @db.Timestamp(0)

  @@index([userId, conversationId, isOwner, isAdmin, isMember, joinedAt, leavedAt], name: "idx_conversation_user_active_status")
  @@map("conversation_users")
}

model Message {
  id             BigInt       @id @default(autoincrement())
  senderId       BigInt       @map("sender_id")
  receiverId     BigInt?      @map("receiver_id")
  conversationId BigInt       @map("conversation_id")
  content        String       @db.LongText
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  receiver       User?        @relation("MessageReceiver", fields: [receiverId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp(0)

  @@index([senderId, receiverId, conversationId, createdAt], name: "idx_private_message_active_status")
  @@map("messages")
}
